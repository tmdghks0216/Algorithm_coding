import java.io.*;
class Main {
	public static void main(String[] args) throws Exception {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		String input = br.readLine();
		String[] numbers  = input.split(" "); 
		
		long am = Long.parseLong(numbers[0]);
		long cm = Long.parseLong(numbers[1]);
		long bm = Long.parseLong(numbers[2]);

		long numerator = am * bm;
    long denominator = cm;
    long common = gcd(numerator, denominator);

        System.out.println((numerator / common) + " " + (denominator / common));
    }

    public static long gcd(long a, long b) {
        while (b != 0) {
            long temp = a % b;
            a = b;
            b = temp;
        }
        return a;
    }
}